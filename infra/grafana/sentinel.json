{
  "uid": "sentinel-overview",
  "title": "Sentinel overview",
  "description": "Sentinel API, queue, agents, findings, detections and action broker. Metric names from app/core/telemetry.py.",
  "tags": [
    "sentinel",
    "security"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "variables": [],
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Canary hits",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "sum(increase(sentinel_detections_total{rule=\"canary.tripwire\"}[5m])) > 0",
        "titleFormat": "Canary tripped",
        "step": "1m"
      }
    ]
  },
  "links": [
    {
      "title": "Runbooks",
      "type": "link",
      "url": "https://github.com/eekosystems/sentinel-agentic-security/blob/main/docs/RUNBOOKS.md",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
