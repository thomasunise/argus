name        = "argus"
environment = "production"
region      = "us-east-1"

# Pin a digest from a signed release (see .github/workflows/release.yml). This stack always
# configures the object-lock audit sink (AUDIT_S3_BUCKET), which needs the `<tag>-extras` image
# (boto3 / azure-storage-blob); use the "Extras image" digest from the release notes, not the base one.
image = "ghcr.io/thomasunise/argus@sha256:REPLACE_WITH_RELEASE_EXTRAS_DIGEST"

# Provision the database and restricted argus_runtime role first (docs/TENANT-ISOLATION.md).
# Use the non-owner account, never the RDS master login. Treat this value as a secret.
runtime_database_url = "postgresql+psycopg://argus_runtime:REPLACE_WITH_SECRET@RDS_HOST:5432/argus?sslmode=require"

domain_name    = "argus.example.com"
hosted_zone_id = "Z0000000000000000000"

api_desired_count    = 2
worker_desired_count = 2

db_instance_class = "db.t4g.medium"
redis_node_type   = "cache.t4g.small"

# Object Lock compliance retention for audit records. Cannot be shortened later.
audit_retention_days = 365

extra_environment = {
  AI_PROVIDER     = "none"
  TOTP_REQUIRED   = "true"
  OIDC_ISSUER     = ""
  OIDC_CLIENT_ID  = ""
}
