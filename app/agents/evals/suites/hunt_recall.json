          {"key": "e3", "source": "cloudtrail", "external_id": "3", "actor": "svc-backup", "entity": "eval-bucket-3", "action": "s3.GetObject", "category": "cloud_api", "title": "GetObject", "minutes_ago": 28},
          {"key": "e4", "source": "cloudtrail", "external_id": "4", "actor": "svc-backup", "entity": "eval-bucket-4", "action": "s3.GetObject", "category": "cloud_api", "title": "GetObject", "minutes_ago": 27},
