{
  "description": "Hypothesis hunts over seeded events and findings. Pass when the entities (or evidence ids) the case plants are recovered at or above min_recall and no forbidden entity is matched.",
  "spec": "hunt",
  "grader": "hunt",
  "task": "Hunt for evidence of the hypothesis.",
  "cases": [
    {
