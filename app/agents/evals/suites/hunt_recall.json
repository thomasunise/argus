      "title": "Failed logins from one actor against the identity provider",
      "inputs": {"hypothesis": "credential stuffing against okta by mallory", "hours": 24},
      "seed": {
        "events": [
          {"key": "e1", "source": "okta", "external_id": "1", "actor": "mallory@eval.test", "entity": "okta", "action": "user.session.failed", "category": "auth", "title": "Login failed", "minutes_ago": 50},
          {"key": "e2", "source": "okta", "external_id": "2", "actor": "mallory@eval.test", "entity": "okta", "action": "user.session.failed", "category": "auth", "title": "Login failed", "minutes_ago": 49},
          {"key": "e3", "source": "okta", "external_id": "3", "actor": "mallory@eval.test", "entity": "okta", "action": "user.session.failed", "category": "auth", "title": "Login failed", "minutes_ago": 48},
          {"key": "e4", "source": "okta", "external_id": "4", "actor": "mallory@eval.test", "entity": "okta", "action": "user.session.failed", "category": "auth", "title": "Login failed", "minutes_ago": 47},
          {"key": "n1", "source": "osquery", "external_id": "5", "actor": "bob@eval.test", "entity": "fileshare-eval", "action": "file.read", "category": "process", "title": "Quarterly report opened", "minutes_ago": 40}
