# REQUIRED: generate strong values, do not commit .env.
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
INGEST_API_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_VALUE
# SQLite is suitable for a single-node pilot. Use proper backups.
DATABASE_URL=sqlite:///./data/sentinel.db
# Set true ONLY behind an HTTPS reverse proxy with correct forwarded HTTPS configuration.
COOKIE_SECURE=false
# Disabled by default. When enabled, runs only approved, web-type assets.
AUTOSCAN_ENABLED=false
AUTOSCAN_MINUTES=360
# Internal addresses blocked by default. Only enable with controlled egress & explicit CIDR allowlist.
ALLOW_PRIVATE_TARGETS=false
PRIVATE_TARGET_CIDRS=
# Optional local repository scanner root. Prefer mounting read-only.
SCAN_ROOT=./targets
ENABLE_TRIVY=false
# AI_PROVIDER: none, ollama, openai, anthropic
AI_PROVIDER=none
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional read-only Wazuh indexer integration, credentials should have least privilege.
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
# For certificate trust use system trust store or a trusted custom bundle path.
WAZUH_CA_BUNDLE=
