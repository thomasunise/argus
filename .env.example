# Argus configuration. Copy to .env and fill in the three REPLACE_ values:
#     cp .env.example .env && python scripts/generate_secrets.py --write
# Every key maps 1:1 to a field in app/core/config.py (Settings). Never commit .env.

# =============================================================================
# App
# =============================================================================
# development | staging | production. production enforces PostgreSQL, REDIS_URL and COOKIE_SECURE=true.
APP_ENV=development
APP_NAME=Argus
# Public origin of this deployment. Used for OIDC redirect URIs and canary URLs.
BASE_URL=http://127.0.0.1:8080
# REQUIRED. >= 32 random characters. Signs the session cookie.
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Session idle timeout in seconds (the cookie is refreshed on every response).
SESSION_MAX_AGE=3600
# Hard session lifetime in seconds from login, regardless of activity.
SESSION_ABSOLUTE_MAX_AGE=43200
# Set true only behind HTTPS (required in production).
COOKIE_SECURE=false
# Create tables with create_all at startup. Keep true for SQLite/dev; set false when Alembic owns the schema.
DB_AUTO_CREATE=true
# Header that carries / returns the per-request id.
REQUEST_ID_HEADER=X-Request-ID

# =============================================================================
# Database and queue
# =============================================================================
# SQLite is for a single-node dev or evaluation install. Production: postgresql+psycopg://user:pass@host:5432/argus
DATABASE_URL=sqlite:///./data/argus.db
# Empty = in-memory queue inside the API process. Set redis://host:6379/0 to use `python -m app.worker` processes.
REDIS_URL=
# Run queue workers inside the API process. Set false when dedicated workers consume REDIS_URL.
WORKERS_INPROCESS=true
# Concurrent jobs per worker process.
WORKER_CONCURRENCY=4
# Retries per job before it is marked failed (exponential backoff, max 300s).
QUEUE_MAX_ATTEMPTS=3

# =============================================================================
# Authentication
# =============================================================================
# Bootstrap owner of the default tenant. ADMIN_PASSWORD is applied when the account is created; set
# ADMIN_PASSWORD_RESET=true for one restart to re-apply it (recovery), otherwise API-side rotations stick.
ADMIN_EMAIL=admin@argus.local
# REQUIRED. >= 14 characters.
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
ADMIN_PASSWORD_RESET=false
DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_NAME=Default
# Optional bootstrap API key (scope "ingest", role viewer) for sensors. Must have the argus_<prefix>_<secret>
# shape produced by scripts/generate_secrets.py (the same format as keys minted through the API).
INGEST_API_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_VALUE
# Require TOTP on every session (users enrol via POST /api/v1/auth/totp/enroll).
TOTP_REQUIRED=false
# OIDC single sign-on (authorization code + PKCE). Leave OIDC_ISSUER empty to disable.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Role granted to auto-provisioned SSO users: viewer | analyst | operator | admin | owner
OIDC_DEFAULT_ROLE=viewer
# Link an SSO identity to an existing local account by email even when the IdP does not send email_verified=true
# (Entra ID does not by default). Leave false unless you trust the IdP's email claim completely.
OIDC_TRUST_EMAIL=false
# Comma-separated email domains allowed to sign in via OIDC. Empty = any domain the IdP returns.
OIDC_ALLOWED_DOMAINS=
# Create a user + membership on first SSO login.
OIDC_AUTO_PROVISION=true
# Login throttling per client IP.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300

# =============================================================================
# Audit chain and sinks
# =============================================================================
# Append-only JSONL mirror of every audit entry (in the container: /app/data/audit.jsonl).
AUDIT_JSONL_PATH=
# HMAC key added to every entry so a DB admin cannot rewrite history. Generate with scripts/generate_secrets.py.
AUDIT_SIGNING_KEY=
# Keyed rotation form: 'k2=<new>,k1=<old>' (first signs, all verify). Use instead of AUDIT_SIGNING_KEY when rotating.
AUDIT_SIGNING_KEYS=
# S3 bucket with Object Lock (compliance mode). Credentials come from the ambient AWS chain (IAM role).
AUDIT_S3_BUCKET=
AUDIT_S3_PREFIX=argus-audit/
# Azure immutable blob container (needs both values).
AUDIT_AZURE_CONTAINER=
AUDIT_AZURE_CONNECTION_STRING=

# =============================================================================
# Telemetry
# =============================================================================
# JSON logs (one object per line) for log shippers.
LOG_JSON=false
LOG_LEVEL=INFO
# Expose Prometheus metrics on /metrics (unauthenticated; keep it off the public ingress).
METRICS_ENABLED=true
# OTLP/HTTP traces endpoint, e.g. http://otel-collector:4318/v1/traces. Empty = tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=argus

# =============================================================================
# AI providers and agent budgets
# =============================================================================
# none | anthropic | openai | ollama. With none, specialists run their deterministic fallbacks.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Anthropic effort level: low | medium | high
ANTHROPIC_EFFORT=high
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# From inside a container, 127.0.0.1 is the container itself; point at the inference host.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
# Hard budgets per agent run.
AGENT_MAX_STEPS=12
AGENT_MAX_TOKENS=150000
AGENT_MAX_SECONDS=300
# Characters of a tool result shown to the model.
AGENT_TOOL_RESULT_LIMIT=6000
# Per-run spending cap. Only enforced for models with a known price: the built-in table covers
# Claude models and Ollama counts as free; for anything else (e.g. OpenAI) set AGENT_MODEL_PRICES.
AGENT_COST_CEILING_USD=5.0
# USD per million tokens, input:output, comma separated: gpt-4.1=2:8,my-model=0.5:1.5
AGENT_MODEL_PRICES=

# =============================================================================
# Testing harness
# =============================================================================
# Root for repository-type assets. Mount read-only in containers (/app/targets).
SCAN_ROOT=./targets
# Trivy filesystem scans of repos under SCAN_ROOT (needs the trivy binary and a warmed DB).
ENABLE_TRIVY=false
TRIVY_BIN=trivy
NUCLEI_BIN=nuclei
# Directory of reviewed nuclei templates. Empty = adapter unavailable.
NUCLEI_TEMPLATES=
SEMGREP_BIN=semgrep
GITLEAKS_BIN=gitleaks
PROWLER_BIN=prowler
# OWASP ZAP API (active tier, staging/lab only).
ZAP_URL=
ZAP_API_KEY=
# MITRE CALDERA (intrusive tier, lab only).
CALDERA_URL=
CALDERA_API_KEY=
# Global ceiling on requests per second any adapter may send to one target.
TEST_RATE_LIMIT_RPS=5.0
# Kill an external tool after this many seconds.
TEST_TOOL_TIMEOUT_SECONDS=900
# RFC1918 and other private targets are denied unless enabled with an explicit allowlist.
ALLOW_PRIVATE_TARGETS=false
# Comma-separated CIDRs, e.g. 10.23.45.0/24. Loopback, link-local and multicast stay denied.
PRIVATE_TARGET_CIDRS=
# Run scheduled test plans. Only plans inside a valid scope ever execute.
AUTOSCAN_ENABLED=false
# Minimum 15.
AUTOSCAN_MINUTES=360
# Autonomous pentesting (docs/AUTOPENTEST.md): off unless this, the tenant opt-in AND a scope marked autonomous allow it.
AUTOPENTEST_ENABLED=false
# true stops every autopilot run before its next launch.
AUTOPENTEST_KILL_SWITCH=false
# Native autonomous pentest (Pen Test tab, docs/NATIVE-PENTEST.md): installed by default.
# A run still needs a scope marked autonomous and a current asset authorization.
PENTEST_ENABLED=true
PENTEST_KILL_SWITCH=false
PENTEST_MAX_STEPS=20
PENTEST_MAX_ROUNDS=3
PENTEST_MAX_TEST_RUNS=20

# =============================================================================
# Action broker
# =============================================================================
# true rejects every action request and execution, tenant settings notwithstanding.
ACTIONS_KILL_SWITCH=false
# Auto-approve low-risk reversible actions whose dry run stays under blast-radius thresholds.
ACTIONS_AUTO_APPROVE_LOW=false
# Two distinct approvers for high-risk actions (critical always needs two plus an owner).
ACTIONS_REQUIRE_TWO_FOR_HIGH=true
# UTC window outside of which actions wait, e.g. 02:00-04:00. Empty = no window.
ACTIONS_MAINTENANCE_WINDOW=
# Endpoint containment credentials (read by the crowdstrike.* and sentinelone.* actions; values may be secret refs).
# CrowdStrike API client with Hosts: Read + Write. Base URL: api.crowdstrike.com, api.us-2..., api.eu-1..., api.laggar.gcw...
ACTIONS_CROWDSTRIKE_CLIENT_ID=
ACTIONS_CROWDSTRIKE_CLIENT_SECRET=
ACTIONS_CROWDSTRIKE_BASE_URL=
# SentinelOne console origin (https://<tenant>.sentinelone.net) and an API token allowed to disconnect endpoints.
ACTIONS_SENTINELONE_API_URL=
ACTIONS_SENTINELONE_TOKEN=

# =============================================================================
# Autonomous response (see docs/AUTONOMOUS-RESPONSE.md). Off unless this AND the tenant opt in.
# =============================================================================
AUTORESPONSE_ENABLED=false
# Enforced autonomous actions per tenant per hour (a tenant may set a lower cap).
AUTORESPONSE_MAX_PER_HOUR=20
# How often expired autonomous actions are rolled back.
AUTORESPONSE_SWEEP_SECONDS=60

# =============================================================================
# Threat intel enrichment: CISA KEV and FIRST EPSS on findings with CVEs (see docs/INTEL.md)
# =============================================================================
INTEL_ENRICHMENT_ENABLED=true
# true = never fetch; put kev.json and epss_scores-current.csv.gz in INTEL_CACHE_DIR yourself (air-gapped installs).
INTEL_OFFLINE=false
INTEL_CACHE_DIR=./data/intel
INTEL_KEV_REFRESH_HOURS=12
INTEL_EPSS_TTL_HOURS=24
# KEV-listed findings are raised to at least this severity. Empty disables.
INTEL_KEV_MIN_SEVERITY=high
# Raise findings whose EPSS score is at least this to high. 0 disables.
INTEL_EPSS_ESCALATE_THRESHOLD=0

# =============================================================================
# Backups (see docs/BACKUP.md). `python -m app.ops backup create` works whether or not this is on.
# =============================================================================
BACKUP_ENABLED=false
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=24
# Newest backups kept in every store; older ones are deleted.
BACKUP_KEEP=7
# Encrypts backup files. Empty: a key derived from DATA_ENCRYPTION_KEY is used. Either way, keep the key off the server.
BACKUP_ENCRYPTION_KEY=
BACKUP_MIN_FREE_MB=1024
# Off-host copies (need requirements-optional.txt / the -extras image). S3-compatible storage: set AWS_ENDPOINT_URL_S3.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=argus-backups/
BACKUP_AZURE_CONTAINER=
BACKUP_AZURE_CONNECTION_STRING=

# =============================================================================
# Data retention, in days (0 keeps forever). Tenants can override each value through /api/v1/retention.
# The audit log, findings, assets and configuration are never pruned.
# =============================================================================
RETENTION_ENABLED=false
RETENTION_EVENTS_DAYS=90
RETENTION_DETECTIONS_DAYS=365
RETENTION_AGENT_RUNS_DAYS=90
RETENTION_RUNS_DAYS=180
RETENTION_DELIVERIES_DAYS=30
RETENTION_INGEST_BATCHES_DAYS=30
RETENTION_AI_GATEWAY_DAYS=90
RETENTION_CANARY_HITS_DAYS=365

# =============================================================================
# AI gateway and shadow-AI discovery (docs/AI-GATEWAY.md)
# =============================================================================
# Governed proxy for OpenAI / Anthropic calls made with Argus API keys (scope ai_gateway:use).
AI_GATEWAY_ENABLED=false
# Organization provider keys: a value or a secret reference (env:ARGUS_SECRET_..., file:/run/secrets/...).
AI_GATEWAY_OPENAI_API_KEY=
AI_GATEWAY_ANTHROPIC_API_KEY=
AI_GATEWAY_OPENAI_BASE_URL=https://api.openai.com
AI_GATEWAY_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_GATEWAY_TIMEOUT_SECONDS=120
AI_GATEWAY_MAX_REQUEST_BYTES=2097152
AI_GATEWAY_REQUESTS_PER_MINUTE=120
# Extra prices for cost metering, USD per million tokens: model=input:output,...
AI_GATEWAY_MODEL_PRICES=
# Periodic scan of ingested events for AI-service use.
AI_DISCOVERY_ENABLED=true
AI_DISCOVERY_INTERVAL_MINUTES=15

# =============================================================================
# Secrets backend (for collector / integration secret_ref values)
# =============================================================================
# env | file. Refs look like env:NAME, file:/path, secrets:KEY (file backend reads SECRETS_FILE as JSON).
SECRETS_BACKEND=env
SECRETS_FILE=
# Encryption at rest for stored secrets (TOTP seeds, integration credentials). REQUIRED in production.
# Generate with scripts/generate_secrets.py. Rotation: DATA_ENCRYPTION_KEYS=k2=<new>,k1=<old> (first encrypts, all decrypt).
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEYS=

# =============================================================================
# Legacy Wazuh indexer poll (read-only user, TLS)
# =============================================================================
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
# Path to a trusted CA bundle; empty = system trust store.
WAZUH_CA_BUNDLE=

# =============================================================================
# Rate limits (per minute, in-process; put an edge limiter in front for production)
# =============================================================================
INGEST_RATE_LIMIT_PER_MINUTE=1200
API_RATE_LIMIT_PER_MINUTE=600

# =============================================================================
# Container / compose only (read by docker/entrypoint.sh and compose.yaml, not by Settings)
# =============================================================================
# Run scripts/migrate.py before starting the API.
RUN_MIGRATIONS=false
# Uvicorn trusts X-Forwarded-* from these IPs only (your TLS proxy).
FORWARDED_ALLOW_IPS=127.0.0.1
# Password for the compose postgres service.
POSTGRES_PASSWORD=argus-dev-password
# compose.prod.yaml: public hostname and ACME contact for Caddy.
ARGUS_DOMAIN=
ACME_EMAIL=

# --- secret reference policy (enforced by resolve_secret) ---
# env: references must start with this prefix or be listed in SECRET_ENV_ALLOWLIST; '*' is development only.
SECRET_ENV_PREFIX=ARGUS_SECRET_
SECRET_ENV_ALLOWLIST=
# file: references must resolve under this directory (Kubernetes/Docker secret mounts).
SECRETS_DIR=/run/secrets
# literal: references are refused in production regardless of this value; where allowed they are encrypted
# at rest and shown to API clients as literal:[set].
ALLOW_LITERAL_SECRET_REFS=true
# Maximum HTTP request body in bytes (ingest additionally caps at 2 MB).
MAX_REQUEST_BODY_BYTES=8388608
