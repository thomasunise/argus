.env
.venv/
__pycache__/
.pytest_cache/
*.pyc
/data/
targets/
*.db
*.sqlite
*.sqlite3
*.log
# Collector sample data under tests/fixtures is synthetic and needed by the tests.
!tests/fixtures/**/*.log
!app/testing//data/**

# Terraform working directories (providers are cached in TF_PLUGIN_CACHE_DIR); keep .terraform.lock.hcl
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.tfstate.lock.info
